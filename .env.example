# Copy to .env for local use. Replace the secret before any public deployment.
DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIME_ZONE=Asia/Shanghai

POSTGRES_DB=baby_study
POSTGRES_USER=baby_study
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://baby_study:local-development-only@127.0.0.1:5432/baby_study

# MiMo: set the real API key only in the untracked server .env.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Optional regional Batch URL from the MiMo console; no realtime URL fallback.
MIMO_BATCH_BASE_URL=https://batch-api-cn.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.6-flash
MIMO_IMAGE_MODEL=mimo-v2.6-flash
MIMO_AUDIO_MODEL=mimo-v2.6-flash
MIMO_TIMEOUT_SECONDS=60
MIMO_CONNECT_TIMEOUT_SECONDS=10
# Additional attempts after the first call; 0 disables retries (maximum 5).
# Retried timeouts/temporary errors may already have incurred provider charges.
MIMO_MAX_RETRIES=2
MIMO_RETRY_BACKOFF_SECONDS=1
MIMO_RETRY_MAX_DELAY_SECONDS=30
MIMO_MAX_COMPLETION_TOKENS=4096
